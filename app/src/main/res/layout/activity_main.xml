<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0E14"
    android:padding="20dp">

    <!-- Scrollable content just in case screen size is small -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <!-- Circular Status Indicator -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="24dp">
                
                <!-- Translucent Outer Ring -->
                <View
                    android:id="@+id/status_ring"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:background="@android:drawable/presence_online"
                    android:backgroundTint="#1F00E676" />
                
                <!-- Inner Circular Dot -->
                <View
                    android:id="@+id/status_dot"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:background="@android:drawable/presence_online"
                    android:backgroundTint="#00E676" />
            </FrameLayout>

            <!-- Status Label -->
            <TextView
                android:id="@+id/tv_protection_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PROTECTION ACTIVE"
                android:textColor="#00E676"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="4dp"/>

            <!-- Status Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DNS CORE SERVICE"
                android:textColor="#7E8B9B"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:layout_marginBottom="32dp"/>

            <!-- CARD 1: SYSTEM CORE DIAGNOSTICS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="20dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SYSTEM CORE DIAGNOSTICS"
                    android:textColor="#7E8B9B"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="20dp"/>

                <!-- Accessibility Service Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Accessibility Service"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold"/>

                        <!-- Status with small green/red dot -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="4dp">
                            
                            <View
                                android:id="@+id/accessibility_indicator_dot"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:layout_marginRight="6dp"
                                android:background="@android:drawable/presence_online"
                                android:backgroundTint="#00E676"/>
                            
                            <TextView
                                android:id="@+id/accessibility_status_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ACTIVE"
                                android:textColor="#00E676"
                                android:textSize="12sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_accessibility_halt"
                        android:layout_width="90dp"
                        android:layout_height="38dp"
                        android:text="HALT"
                        android:textColor="#FF5252"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/btn_border_red"
                        android:gravity="center"
                        android:padding="0dp"/>
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#1E293B"
                    android:layout_marginBottom="16dp"/>

                <!-- Device Administrator Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Device Administrator"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold"/>

                        <!-- Status with small green/red dot -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="4dp">
                            
                            <View
                                android:id="@+id/admin_indicator_dot"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:layout_marginRight="6dp"
                                android:background="@android:drawable/presence_online"
                                android:backgroundTint="#00E676"/>
                            
                            <TextView
                                android:id="@+id/admin_status_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ACTIVE"
                                android:textColor="#00E676"
                                android:textSize="12sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_admin_halt"
                        android:layout_width="90dp"
                        android:layout_height="38dp"
                        android:text="HALT"
                        android:textColor="#FF5252"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/btn_border_red"
                        android:gravity="center"
                        android:padding="0dp"/>
                </LinearLayout>

            </LinearLayout>

            <!-- CARD 2: ACTIVE SHIELDS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="20dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACTIVE APP SHIELDS"
                    android:textColor="#7E8B9B"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="20dp"/>

                <!-- DNS Blocker protection Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Custom Logo Frame -->
                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/card_bg"
                        android:backgroundTint="#1A1E293B"
                        android:layout_marginRight="16dp"
                        android:padding="8dp">
                        
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_shield_secure"/>
                    </FrameLayout>

                    <!-- Text details -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DNS Blocker Protection"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Blocks editing/accessing of the Private DNS settings popup."
                            android:textColor="#7E8B9B"
                            android:textSize="11sp"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <!-- Toggle Switch -->
                    <Switch
                        android:id="@+id/switch_blocker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:trackTint="#7E8B9B"
                        android:thumbTint="#00E676" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
