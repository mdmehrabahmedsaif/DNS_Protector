# ==============================================================================
# DNS Protector - Environment Configuration File
# Version: 1.0.0
# Description: Configuration template for building, configuring, and deploying DNS Protector.
# Copy this file to .env and customize the parameters before building or deploying.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Metadata & Build Settings
# ------------------------------------------------------------------------------
# Human-readable name of the Android application
APP_NAME="DNS Protector"

# Unique Android application package identifier
APPLICATION_ID="com.dns.protector"

# Release version string displayed in UI
APP_VERSION_NAME="1.0.0"

# Incremental build version code (integer)
APP_VERSION_CODE=1

# Build target environment: 'production', 'staging', or 'development'
ENVIRONMENT="production"

# Java compiler target version
JAVA_VERSION="17"

# Android compile SDK version
ANDROID_COMPILE_SDK="34"

# Android minimum SDK version supported (24 = Android 7.0 Nougat)
ANDROID_MIN_SDK="24"

# Android target SDK version
ANDROID_TARGET_SDK="34"

# ------------------------------------------------------------------------------
# 2. Protection Engine & Security Policies
# ------------------------------------------------------------------------------
# Master switch to activate the background DNS modification blocker
PROTECTION_ENABLED_BY_DEFAULT=true

# Package name of Android system settings to intercept
BLOCKED_SETTINGS_PACKAGE="com.android.settings"

# System dialog title that opens when tapping Private DNS in Android settings
TARGET_DIALOG_TITLE="Select Private DNS Mode"

# Delay (in milliseconds) before re-checking UI tree after accessibility event
BLOCKER_POLL_DELAY_MS=300

# Delay (in milliseconds) before forcefully bringing DNS Protector back to front
APP_REORDER_TO_FRONT_DELAY_MS=800

# Whether Device Administrator privilege is requested during initial setup
ENABLE_DEVICE_ADMIN_UNINSTALL_PROTECTION=true

# ------------------------------------------------------------------------------
# 3. DNS Filter Profiles & Endpoints
# ------------------------------------------------------------------------------
# Active DNS filter provider name ('NextDNS', 'AdGuard', 'CleanBrowsing', 'Custom')
ACTIVE_DNS_PROVIDER="NextDNS"

# Primary DNS-over-TLS (DoT) hostname to enforce
NEXTDNS_DOT_HOSTNAME="custom-id.dns.nextdns.io"

# DNS-over-HTTPS (DoH) endpoint URL
NEXTDNS_DOH_URL="https://dns.nextdns.io/custom-id"

# Secondary/Fallback DNS provider (e.g. AdGuard Family)
FALLBACK_DOT_HOSTNAME="family.adguard-dns.com"

# Fallback DNS IPv4 primary server
FALLBACK_DNS_IPV4="94.140.14.15"

# ------------------------------------------------------------------------------
# 4. Optional Security Pin & Tamper Lock
# ------------------------------------------------------------------------------
# Require a PIN code inside the app before allowing protection to be halted
ADMIN_PIN_PROTECTION_ENABLED=false

# Salt string used for hashing admin password/PIN locally
ADMIN_HASH_SALT="change_this_to_a_random_secure_hex_salt"

# Maximum number of incorrect PIN attempts before temporary lockout
MAX_PIN_ATTEMPTS=5

# Lockout duration in minutes after exceeding max failed PIN attempts
PIN_LOCKOUT_MINUTES=30

# ------------------------------------------------------------------------------
# 5. Logging & Diagnostics
# ------------------------------------------------------------------------------
# Enable or disable local debug log output in Android Logcat
DEBUG_LOGGING_ENABLED=false

# Log tag string used across Android services
LOG_TAG="PrivateDnsBlocker"

# Persist tamper events to local storage for audit review
ENABLE_TAMPER_AUDIT_LOGGING=true
